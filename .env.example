# Application Settings
PROJECT_NAME="FoodLence Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
SECRET_KEY="replace_this_with_a_super_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="foodlence_user"
POSTGRES_PASSWORD="foodlence_password"
POSTGRES_DB="foodlence_db"
DATABASE_URL="postgresql://foodlence_user:foodlence_password@localhost:5432/foodlence_db"

# CORS Configuration (Comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://10.0.2.2:8000"]

# NLP & ML Model Config
SPACY_MODEL="en_core_web_sm"
SIMILARITY_THRESHOLD=0.75
CONFIDENCE_THRESHOLD=0.70
